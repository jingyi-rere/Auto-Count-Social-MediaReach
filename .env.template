# ============================================================
#  Auto Count Social Media Reach — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to GitHub. Only .env.template is safe to share.
# ============================================================

# ── LARK BITABLE ─────────────────────────────────────────────
# From your Lark Open Platform app (https://open.larksuite.com)
LARK_APP_ID=your_lark_app_id_here
LARK_APP_SECRET=your_lark_app_secret_here

# From your Lark Bitable URL:
# https://ricebowlmy.larksuite.com/base/YOUR_APP_TOKEN?table=YOUR_TABLE_ID
LARK_APP_TOKEN=your_lark_app_token_here
LARK_TABLE_ID=your_lark_table_id_here

# ── ANTHROPIC (Claude AI) ─────────────────────────────────────
# From https://console.anthropic.com — create an API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── LARK FIELD NAMES (optional) ──────────────────────────────
# Only set these if your Lark column names differ from the defaults.
# Defaults shown — leave commented out if your columns already match.
# LARK_FIELD_DATE=Date
# LARK_FIELD_CAPTION=Title
# LARK_FIELD_CONTENT_TYPE=Content Type
# LARK_FIELD_VIEWS=Reach
